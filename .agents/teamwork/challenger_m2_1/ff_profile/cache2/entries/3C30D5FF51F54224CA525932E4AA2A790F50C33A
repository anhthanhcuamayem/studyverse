    // gá»i API streaming, lá»—i thÃ¬ fallback vá» endpoint thÆ°á»ng
    async function streamAI(message, onDelta) {
        const context = collectContext();
        const body = {
            message: message,
            history: conversationHistory.slice(0, -1), // gá»­i lá»‹ch sá»­ (trá»« tin nháº¯n vá»«a thÃªm)
            ...context
        };

        const response = await fetch('/api/career-ai-stream', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

        if (!response.ok || !response.body) {
            // Lá»—i HTTP (400/503...) â€” Ä‘á»c JSON lá»—i Ä‘á»ƒ hiá»ƒn thá»‹
            let errText = svT('career.unknown');
            try {
                const data = await response.json();
                errText = data.error || errText;
            } catch (e) { /* khÃ´ng parse Ä‘Æ°á»£c */ }
            throw new Error(errText);
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let finalError = null;
        let finished = false;  // Ä‘Ã£ nháº­n event káº¿t thÃºc ({"success": ...} / {"error": ...}) chÆ°a?

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });

            let sepIdx;
            while ((sepIdx = buffer.indexOf('\n\n')) !== -1) {
                const rawEvent = buffer.slice(0, sepIdx);
                buffer = buffer.slice(sepIdx + 2);
                for (const line of rawEvent.split('\n')) {
                    if (!line.startsWith('data: ')) continue;
                    const payload = line.slice(6);
                    if (payload === '[DONE]') continue;
                    try {
                        const evt = JSON.parse(payload);
                        if (evt.delta) {
                            onDelta(evt.delta);
                        } else if (evt.error) {
                            finalError = evt.error;
                            finished = true;
                        } else if (evt.success) {
                            finished = true;
                        }
                    } catch (e) { /* bá» qua event lá»—i Ä‘á»‹nh dáº¡ng */ }
                }
            }
        }

        if (finalError) throw new Error(finalError);
        // Server luÃ´n gá»­i event káº¿t thÃºc ({"success": true} hoáº·c {"error": ...}) trÆ°á»›c [DONE].
        // KhÃ´ng tháº¥y event Ä‘Ã³ nghÄ©a lÃ  káº¿t ná»‘i bá»‹ Ä‘á»©t giá»¯a chá»«ng (proxy/máº¡ng) â€” náº¿u bá» qua,
        // pháº§n tráº£ lá»i dá»Ÿ (Ä‘Ã´i khi chá»‰ má»™t chá»¯) sáº½ bá»‹ coi lÃ  cÃ¢u tráº£ lá»i hoÃ n chá»‰nh vÃ  lÆ°u vÃ o
        // lá»‹ch sá»­. NÃ©m lá»—i Ä‘á»ƒ sendToAI() thá»­ láº¡i qua endpoint khÃ´ng streaming.
        if (!finished) throw new Error(svT('career.unknown'));
    }

    // Fallback: gá»i endpoint thÆ°á»ng khi streaming lá»—i giá»¯a chá»«ng
    async function sendToAIFallback(message) {
        const context = collectContext();
        const response = await fetch('/api/career-ai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                message: message,
                history: conversationHistory.slice(0, -1),
                ...context
            })
        });
        const data = await response.json();
        if (data.success) return data.reply;
        throw new Error(data.error || svT('career.unknown'));
    }

    // ===== AI Ä‘á» xuáº¥t chá»‰nh sá»­a Todo / Thá»i khÃ³a biá»ƒu =====
    // CÃ¢u tráº£ lá»i cÃ³ thá»ƒ kÃ¨m khá»‘i ```studyverse-actions```; server Ä‘á»c/kiá»ƒm tra khá»‘i Ä‘Ã³
    // rá»“i tráº£ vá» danh sÃ¡ch thay Ä‘á»•i. NgÆ°á»i dÃ¹ng duyá»‡t trong tháº» xem trÆ°á»›c trÆ°á»›c khi ghi.
    async function fetchActionPlan(replyText) {
        try {
            const response = await fetch('/api/ai-actions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reply: replyText, ...collectContext() })
            });
            if (!response.ok) return null;
            const plan = await response.json();
            return plan && typeof plan === 'object' ? plan : null;
        } catch (error) {
            console.warn('KhÃ´ng Ä‘á»c Ä‘Æ°á»£c Ä‘á» xuáº¥t thay Ä‘á»•i cá»§a AI:', error);
            return null;
        }
    }

