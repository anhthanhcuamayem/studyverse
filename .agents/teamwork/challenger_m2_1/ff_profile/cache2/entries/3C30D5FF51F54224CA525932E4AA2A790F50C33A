    async function sendToAI(message) {
        const typingDiv = addTypingIndicator();
        let streamed = false;

        const { messageDiv, contentP, contentDiv } = addMessage('', false);
        messageDiv.style.display = 'none'; // áº©n tin nháº¯n trá»‘ng cho tá»›i khi cÃ³ chá»¯ Ä‘áº§u tiÃªn

        const onDelta = (piece) => {
            if (!streamed) {
                streamed = true;
                typingDiv.remove();
                messageDiv.style.display = '';
            }
            contentP.textContent += piece;
            chatMessages.scrollTop = chatMessages.scrollHeight;
        };

        try {
            await streamAI(message, onDelta);
            // Render markdown sau khi stream xong Ä‘á»ƒ khÃ´ng phÃ¡ vá»¡ tá»«ng máº£nh Ä‘ang gÃµ.
            await finalizeAnswer(messageDiv, contentDiv, contentP.textContent);
        } catch (error) {
