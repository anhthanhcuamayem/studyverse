            message: message,
            history: conversationHistory.slice(0, -1), // gá»­i lá»‹ch sá»­ (trá»« tin nháº¯n vá»«a thÃªm)
            ...context
        };

        const response = await fetch('/api/career-ai-stream', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

        if (!response.ok || !response.body) {
            // Lá»—i HTTP (400/503...) â€” Ä‘á»c JSON lá»—i Ä‘á»ƒ hiá»ƒn thá»‹
            let errText = svT('career.unknown');
            try {
                const data = await response.json();
                errText = data.error || errText;
            } catch (e) { /* khÃ´ng parse Ä‘Æ°á»£c */ }
            throw new Error(errText);
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let finalError = null;
        let finished = false;  // Ä‘Ã£ nháº­n event káº¿t thÃºc ({"success": ...} / {"error": ...}) chÆ°a?

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });

            let sepIdx;
            while ((sepIdx = buffer.indexOf('\n\n')) !== -1) {
                const rawEvent = buffer.slice(0, sepIdx);
                buffer = buffer.slice(sepIdx + 2);
                for (const line of rawEvent.split('\n')) {
                    if (!line.startsWith('data: ')) continue;
                    const payload = line.slice(6);
                    if (payload === '[DONE]') continue;
                    try {
                        const evt = JSON.parse(payload);
                        if (evt.delta) {
                            onDelta(evt.delta);
                        } else if (evt.error) {
                            finalError = evt.error;
                            finished = true;
                        } else if (evt.success) {
                            finished = true;
                        }
                    } catch (e) { /* bá» qua event lá»—i Ä‘á»‹nh dáº¡ng */ }
                }
            }
        }

        if (finalError) throw new Error(finalError);
        // Server luÃ´n gá»­i event káº¿t thÃºc ({"success": true} hoáº·c {"error": ...}) trÆ°á»›c [DONE].
        // KhÃ´ng tháº¥y event Ä‘Ã³ nghÄ©a lÃ  káº¿t ná»‘i bá»‹ Ä‘á»©t giá»¯a chá»«ng (proxy/máº¡ng) â€” náº¿u bá» qua,
        // pháº§n tráº£ lá»i dá»Ÿ (Ä‘Ã´i khi chá»‰ má»™t chá»¯) sáº½ bá»‹ coi lÃ  cÃ¢u tráº£ lá»i hoÃ n chá»‰nh vÃ  lÆ°u vÃ o
        // lá»‹ch sá»­. NÃ©m lá»—i Ä‘á»ƒ sendToAI() thá»­ láº¡i qua endpoint khÃ´ng streaming.
        if (!finished) throw new Error(svT('career.unknown'));
    }

