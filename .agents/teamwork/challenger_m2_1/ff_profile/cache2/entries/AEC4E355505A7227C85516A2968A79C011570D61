// AI tr·∫£ l·ªùi k√®m m·ªôt kh·ªëi ```studyverse-actions {...}```. Server ƒë·ªçc + ki·ªÉm tra kh·ªëi ƒë√≥
// (/api/ai-actions) r·ªìi tr·∫£ v·ªÅ danh s√°ch thay ƒë·ªïi ƒë√£ chu·∫©n h√≥a. Trang AI Career hi·ªÉn
// th·ªã b·∫£n xem tr∆∞·ªõc; ch·ªâ khi ng∆∞·ªùi d√πng b·∫•m x√°c nh·∫≠n m·ªõi g·ªçi svApplyAIActions() ƒë·ªÉ ghi
// v√†o LocalStorage (Todo: studyverse_projects ‚Äî Schedule: studyverse_schedule_dashboard_data).

const SV_ACTION_BLOCK_RE = /```[ \t]*(?:studyverse-actions|json-actions)[ \t]*\r?\n[\s\S]*?```/g;

// B·ªè kh·ªëi h√†nh ƒë·ªông kh·ªèi vƒÉn b·∫£n hi·ªÉn th·ªã (kh·ªëi n√†y ch·ªâ ƒë·ªÉ m√°y ƒë·ªçc).
function svStripActionBlock(text) {
    let out = String(text ?? '').replace(SV_ACTION_BLOCK_RE, '');
    // Model c√≥ th·ªÉ tr·∫£ JSON tr·∫ßn (kh√¥ng b·ªçc ```) ‚Äî khi ƒë√≥ c·∫£ c√¢u tr·∫£ l·ªùi l√† kh·ªëi h√†nh ƒë·ªông.
    const trimmed = out.trim();
    if (trimmed.startsWith('{') && trimmed.endsWith('}')) {
        try {
            const parsed = JSON.parse(trimmed);
            if (parsed && typeof parsed === 'object' && Array.isArray(parsed.actions)) return '';
        } catch (e) { /* kh√¥ng ph·∫£i JSON ‚Üí gi·ªØ nguy√™n */ }
    }
    out = out.replace(/\n{3,}/g, '\n\n');
    return out.trim();
}

const SV_ACTION_ENUM_KEYS = {
    priority: { low: 'todo.lowPriority', medium: 'todo.mediumPriority', high: 'todo.highPriority' },
    status: { todo: 'todo.todoStatus', doing: 'todo.doingStatus', done: 'todo.doneStatus' },
    repeat: { none: 'todo.noRepeat', daily: 'todo.daily', weekly: 'todo.weekly' }
