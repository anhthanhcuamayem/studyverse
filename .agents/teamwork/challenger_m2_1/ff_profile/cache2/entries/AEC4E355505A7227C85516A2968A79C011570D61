const SV_CFG_TIME_RE = /^([01]\d|2[0-3]):[0-5]\d$/;
const SV_CFG_HEX_RE = /^#[0-9a-fA-F]{6}$/;

function _svCfgMinutes(hhmm) {
    const [h, m] = String(hhmm).split(':').map(Number);
    return h * 60 + m;
}

function svValidateConfig(cfg) {
    const target = cfg || window.SV_CONFIG;
    const issues = [];
    const bad = (msg) => issues.push(msg);

    if (!target || typeof target !== 'object') {
        bad('Thi·∫øu window.SV_CONFIG ‚Äî ƒëang t·∫°m d√πng SV_FALLBACK_CONFIG. Th∆∞·ªùng do /config.js tr·∫£ 404 (server Flask ch∆∞a restart sau khi th√™m file config.js) ho·∫∑c m·ªü trang b·∫±ng file://, ho·∫∑c th·∫ª <script src="/config.js"> kh√¥ng ƒë·ª©ng TR∆Ø·ªöC shared.js.');
        return issues;
    }

    // c√†i ƒë·∫∑t chung
    if (target.defaultLang !== 'vi' && target.defaultLang !== 'en') {
        bad(`defaultLang ph·∫£i l√† 'vi' ho·∫∑c 'en' (ƒëang l√† ${JSON.stringify(target.defaultLang)}).`);
    }
    const themes = target.themes;
    if (!Array.isArray(themes) || themes.length === 0) {
        bad('themes ph·∫£i l√† m·∫£ng kh√¥ng r·ªóng (vd ["midnight","ocean"]).');
    } else {
        themes.forEach((t, i) => {
            if (typeof t !== 'string' || !t.trim()) bad(`themes[${i}] ph·∫£i l√† chu·ªói kh√¥ng r·ªóng.`);
        });
        if (!themes.includes(target.defaultTheme)) {
            bad(`defaultTheme "${target.defaultTheme}" kh√¥ng n·∫±m trong themes (${themes.join(', ')}).`);
        }
    }

    // kh√≥a localStorage
    const storage = target.storage;
    if (!storage || typeof storage !== 'object') {
        bad('storage ph·∫£i l√† object ch·ª©a c√°c kh√≥a localStorage.');
    } else {
        ['lang', 'theme', 'projects', 'schedule', 'lastProject'].forEach((k) => {
            if (typeof storage[k] !== 'string' || !storage[k].trim()) {
                bad(`storage.${k} ph·∫£i l√† chu·ªói kh√¥ng r·ªóng.`);
            }
        });
    }

    // l·ªãch (schedule)
    const sc = target.schedule;
    if (!sc || typeof sc !== 'object') {
        bad('schedule ph·∫£i l√† object.');
        return issues;
    }
    if (typeof sc.lessonDuration !== 'number' || !(sc.lessonDuration > 0)) {
        bad('schedule.lessonDuration ph·∫£i l√† s·ªë > 0 (ph√∫t).');
    }
    if (typeof sc.gap !== 'number' || !(sc.gap >= 0)) {
        bad('schedule.gap ph·∫£i l√† s·ªë >= 0 (ph√∫t).');
    }
    if (!Array.isArray(sc.days) || sc.days.length !== 7) {
        bad('schedule.days ph·∫£i l√† m·∫£ng ƒë√∫ng 7 ph·∫ßn t·ª≠.');
    }
    if (!Array.isArray(sc.dayI18nKeys) || sc.dayI18nKeys.length !== 7) {
        bad('schedule.dayI18nKeys ph·∫£i l√† m·∫£ng ƒë√∫ng 7 ph·∫ßn t·ª≠.');
    }
    if (!Array.isArray(sc.subjectColors) || sc.subjectColors.length === 0) {
        bad('schedule.subjectColors ph·∫£i l√† m·∫£ng kh√¥ng r·ªóng.');
    } else {
        sc.subjectColors.forEach((c, i) => {
            if (typeof c !== 'string' || !SV_CFG_HEX_RE.test(c)) bad(`schedule.subjectColors[${i}] kh√¥ng ƒë√∫ng d·∫°ng #RRGGBB ("${c}").`);
        });
    }

    const slots = sc.defaultSlots;
    if (!Array.isArray(slots) || slots.length === 0) {
        bad('schedule.defaultSlots ph·∫£i l√† m·∫£ng kh√¥ng r·ªóng.');
        return issues;
    }

    const ids = {};
    let lessonCount = 0;
    const parsed = [];
    slots.forEach((slot, i) => {
        const at = `schedule.defaultSlots[${i}]`;
        if (!slot || typeof slot !== 'object') { bad(`${at} ph·∫£i l√† object.`); return; }
        if (typeof slot.id !== 'string' || !slot.id.trim()) {
            bad(`${at}.id ph·∫£i l√† chu·ªói kh√¥ng r·ªóng.`);
        } else if (ids[slot.id]) {
            bad(`${at}.id "${slot.id}" b·ªã tr√πng v·ªõi khung kh√°c.`);
        } else {
            ids[slot.id] = true;
        }
        if (slot.type !== 'lesson' && slot.type !== 'break') {
            bad(`${at}.type ph·∫£i l√† 'lesson' ho·∫∑c 'break' (ƒëang l√† ${JSON.stringify(slot.type)}).`);
        }
        if (slot.type === 'lesson') lessonCount++;
        if (slot.type === 'break' && (typeof slot.label !== 'string' || !slot.label.trim())) {
            bad(`${at}.label ph·∫£i l√† kh√≥a i18n cho gi·ªù ngh·ªâ.`);
        }
        const okStart = typeof slot.start === 'string' && SV_CFG_TIME_RE.test(slot.start);
        const okEnd = typeof slot.end === 'string' && SV_CFG_TIME_RE.test(slot.end);
        if (!okStart) bad(`${at}.start ph·∫£i ƒë√∫ng d·∫°ng HH:MM ("${slot.start}").`);
        if (!okEnd) bad(`${at}.end ph·∫£i ƒë√∫ng d·∫°ng HH:MM ("${slot.end}").`);
        if (okStart && okEnd && _svCfgMinutes(slot.end) <= _svCfgMinutes(slot.start)) {
            bad(`${at}: gi·ªù k·∫øt th√∫c (${slot.end}) ph·∫£i sau gi·ªù b·∫Øt ƒë·∫ßu (${slot.start}).`);
        }
        if (okStart && okEnd) parsed.push({ id: slot.id, start: _svCfgMinutes(slot.start), end: _svCfgMinutes(slot.end) });
    });

    if (lessonCount === 0) bad('schedule.defaultSlots c·∫ßn √≠t nh·∫•t m·ªôt khung type "lesson".');

    // Tr√πng / ch·ªìng l·∫•n gi·ªù gi·ªØa c√°c khung
    for (let i = 0; i < parsed.length; i++) {
        for (let j = i + 1; j < parsed.length; j++) {
            if (parsed[i].start < parsed[j].end && parsed[j].start < parsed[i].end) {
                bad(`schedule.defaultSlots: khung "${parsed[i].id}" v√† "${parsed[j].id}" tr√πng/ch·ªìng l·∫•n gi·ªù.`);
            }
        }
    }

    return issues;
}

function svLogConfigIssues(cfg) {
    const issues = svValidateConfig(cfg);
    if (issues.length === 0) {
        console.info('[config.js] OK ‚Äî m·∫∑c ƒë·ªãnh frontend h·ª£p l·ªá.');
        return issues;
    }
    console.warn(`[config.js] Ph√°t hi·ªán ${issues.length} v·∫•n ƒë·ªÅ ‚Äî ƒëang d√πng gi√° tr·ªã d·ª± ph√≤ng cho c√°c kh√≥a sai:`);
    issues.forEach(msg => console.warn('  ‚Ä¢ ' + msg));
    return issues;
}

// ===== Supabase session d√πng chung cho c√°c trang app =====
// C√°c trang (todo, schedule, career) ƒë·ªçc session ƒë·ªÉ bi·∫øt user ƒëang ƒëƒÉng nh·∫≠p v√†
// t√°ch d·ªØ li·ªáu localStorage theo t√†i kho·∫£n. Kh√°ch (ch∆∞a ƒëƒÉng nh·∫≠p) gi·ªØ key g·ªëc
// n√™n d·ªØ li·ªáu c≈© v·∫´n d√πng ƒë∆∞·ª£c nh∆∞ tr∆∞·ªõc.
let SV_STORAGE_SCOPE = '';
let svAuthResolved = false;
let svSupabaseClient = null;
let svSupabasePromise = null;

function svSetStorageScope(scope) {
    SV_STORAGE_SCOPE = String(scope || '').trim();
    return SV_STORAGE_SCOPE;
}

function svGetStorageScope() {
    return SV_STORAGE_SCOPE;
}

// Kh√≥a localStorage theo user: gi·ªØ nguy√™n key g·ªëc cho kh√°ch,
// c√≤n khi ƒë√£ ƒëƒÉng nh·∫≠p th√¨ th√†nh "<key>::<userId>".
function svScopedKey(baseKey) {
    return SV_STORAGE_SCOPE ? `${baseKey}::${SV_STORAGE_SCOPE}` : baseKey;
}

// Nh·∫≠p d·ªØ li·ªáu kh√°ch (key g·ªëc) v√†o t√†i kho·∫£n v·ª´a ƒëƒÉng nh·∫≠p.
// Ch·∫°y tr∆∞·ªõc khi trang app ƒë·ªçc d·ªØ li·ªáu; kh√¥ng ghi ƒë√® d·ªØ li·ªáu ƒë√£ c√≥ c·ªßa t√†i kho·∫£n.
function svMigrateGuestData(userId) {
    if (!userId) return false;
    if (userId !== SV_STORAGE_SCOPE) {
        SV_STORAGE_SCOPE = userId;
    }
    const storage = SV_CFG.storage || {};
    const dataKeys = [storage.projects, storage.schedule, storage.lastProject, storage.careerChat, storage.userProfile, storage.streak, storage.flashcards, storage.lastFlashcardDeck].filter(Boolean);
    if (!dataKeys.length) return false;

    try {
        let moved = false;
        dataKeys.forEach(baseKey => {
            const guestValue = localStorage.getItem(baseKey);
            if (guestValue === null || guestValue === '') return;
            const scopedKey = svScopedKey(baseKey);
            if (scopedKey === baseKey) return;
            const currentScoped = localStorage.getItem(scopedKey);
            let shouldMove = currentScoped === null;
            if (!shouldMove) {
                try {
                    const parsed = JSON.parse(currentScoped);
                    if (Array.isArray(parsed) && parsed.length === 0) shouldMove = true;
                } catch (_) {}
            }
            // T√†i kho·∫£n ch∆∞a c√≥ d·ªØ li·ªáu ri√™ng ho·∫∑c m·∫£ng r·ªóng th√¨ chuy·ªÉn d·ªØ li·ªáu kh√°ch v√†o.
            if (shouldMove) {
                localStorage.setItem(scopedKey, guestValue);
                localStorage.removeItem(baseKey);
                moved = true;
            }
        });
        return moved;
    } catch (error) {
        console.warn('Studyverse guest data migration failed.', error);
        return false;
    }
}

// T·∫°o (m·ªôt l·∫ßn) Supabase client t·ª´ /api/public-config, n·∫°p CDN khi c·∫ßn.
function svSupabase() {
    if (svSupabaseClient) return Promise.resolve(svSupabaseClient);
    if (svSupabasePromise) return svSupabasePromise;

    svSupabasePromise = (async () => {
        const response = await fetch('/api/public-config', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Supabase configuration is unavailable.');
        const config = await response.json();
        const supabaseUrl = String(config.supabaseUrl || '').trim();
        const publishableKey = String(config.supabasePublishableKey || '').trim();
        if (!supabaseUrl || !publishableKey) throw new Error('Supabase configuration is incomplete.');

        if (!window.supabase || typeof window.supabase.createClient !== 'function') {
            await new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2';
                script.async = true;
                script.onload = resolve;
                script.onerror = () => reject(new Error('Could not load the account service.'));
                document.head.appendChild(script);
            });
        }
        if (!window.supabase || typeof window.supabase.createClient !== 'function') {
            throw new Error('Could not initialize the account service.');
        }

        svSupabaseClient = window.supabase.createClient(supabaseUrl, publishableKey, {
            auth: { detectSessionInUrl: true, persistSession: true, autoRefreshToken: true }
        });
        return svSupabaseClient;
    })().catch(error => {
        svSupabasePromise = null;
        throw error;
    });

    return svSupabasePromise;
}

// Promise gi·∫£i quy·∫øt khi ƒë√£ bi·∫øt tr·∫°ng th√°i ƒëƒÉng nh·∫≠p (tr·∫£ session ho·∫∑c null).
// Trang app n√™n `await svAuthReady` tr∆∞·ªõc khi ƒë·ªçc localStorage ƒë√£ t√°ch theo user.
const svAuthReady = (async () => {
    try {
        const client = await svSupabase();
        client.auth.onAuthStateChange((event, session) => {
            if (event === 'INITIAL_SESSION' || !svAuthResolved) return;
            // Trang account t·ª± x·ª≠ l√Ω ƒëi·ªÅu h∆∞·ªõng sau khi ƒëƒÉng nh·∫≠p/ƒëƒÉng xu·∫•t;
            // reload ·ªü ƒë√¢y s·∫Ω tranh ch·∫•p v·ªõi auth.js.
            if (document.getElementById('authForm')) return;
            initHomeActions(session);
            const nextScope = session && session.user ? session.user.id : '';
            if (nextScope === SV_STORAGE_SCOPE) return;
            SV_STORAGE_SCOPE = nextScope;
            // ƒê·ªïi t√†i kho·∫£n ·ªü tab kh√°c ‚Üí n·∫°p l·∫°i ƒë·ªÉ ƒë·ªçc ƒë√∫ng d·ªØ li·ªáu c·ªßa user m·ªõi.
            window.location.reload();
        });

        const { data } = await client.auth.getSession();
        if (data && data.session && data.session.user) {
            SV_STORAGE_SCOPE = data.session.user.id;
            // ƒêƒÉng nh·∫≠p l·∫ßn ƒë·∫ßu tr√™n tr√¨nh duy·ªát n√†y ‚Üí mang d·ªØ li·ªáu kh√°ch v√†o t√†i kho·∫£n.
            svMigrateGuestData(data.session.user.id);
        }
        return data ? data.session : null;
    } catch (error) {
        console.warn('Studyverse session is unavailable.', error);
        return null;
    } finally {
        svAuthResolved = true;
    }
})();

