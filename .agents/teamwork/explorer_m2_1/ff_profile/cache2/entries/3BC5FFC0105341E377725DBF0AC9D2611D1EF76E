.main-career {
    padding-top: calc(160px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(60px + env(safe-area-inset-bottom, 0px));
    min-height: 100vh;
    min-height: 100dvh;
}
.container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
}
.chat-card {
    background: var(--card-bg, #0d1117);
    border: 1px solid var(--border-soft, rgba(255,255,255,0.08));
    border-radius: 32px;
    box-shadow: var(--white-glow, 0 10px 30px -5px rgba(0,0,0,0.3));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* dvh tính theo viewport thật trên mobile (trừ thanh địa chỉ Safari/Chrome);
       dòng 100vh phía trên là fallback cho trình duyệt cũ */
    height: calc(100vh - 220px);
    height: calc(100dvh - 220px);
    min-height: 500px;
}
.chat-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-soft, rgba(255,255,255,0.08));
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}
.header-info {
    display: flex;
    align-items: center;
    gap: 16px;
}
.header-info h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--text-white, #ffffff);
}
.header-info p {
    color: var(--text-gray, rgba(255,255,255,0.6));
    font-size: 0.85rem;
}
.btn-reset {
    background: rgba(255, 77, 77, 0.2);
    border: 1px solid rgba(255, 77, 77, 0.5);
    color: #ff9999;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: 0.2s;
}
.btn-reset:hover {
    background: #ff4d4d;
    color: white;
    border-color: #ff4d4d;
}
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}
.message {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    max-width: 85%;
}
.message.user {
    align-self: flex-end;
    flex-direction: row-reverse;
}
.message .avatar {
    width: 36px;
    height: 36px;
    background: var(--primary-blue, #007AFF);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.message.user .avatar {
    background: var(--primary-blue, #007AFF);
}
.message .avatar i {
    font-size: 1.2rem;
    color: white;
}
.message .content {
    background: var(--card-hover-bg, rgba(255, 255, 255, 0.05));
    border-radius: 18px;
    padding: 12px 18px;
    border: 1px solid var(--border-soft, rgba(255,255,255,0.08));
    color: var(--text-white, #ffffff);
    line-height: 1.5;
    font-size: 0.9rem;
}
.message.user .content {
    background: var(--user-bubble-bg, var(--primary-blue, #007AFF));
    border-color: var(--user-bubble-bg, var(--primary-blue, #007AFF));
    color: #ffffff;
}
.message .content p {
    margin: 0;
    white-space: pre-wrap;
}
/* markdown trong câu trả lời AI */
.message .content > :first-child { margin-top: 0; }
.message .content > :last-child { margin-bottom: 0; }
.message .content p + p, .message .content p + ul, .message .content p + ol,
.message .content ul + p, .message .content ol + p, .message .content pre + p { margin-top: 8px; }
.message .content h3, .message .content h4, .message .content h5, .message .content h6 {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 10px 0 4px;
}
.message .content ul, .message .content ol { margin: 6px 0; padding-left: 20px; }
.message .content li { margin: 2px 0; }
.message .content a { color: #6db3ff; text-decoration: underline; }
.message .content code {
    background: rgba(var(--primary-rgb, 0, 122, 255), 0.12);
    color: var(--text-white, #ffffff);
    padding: 1px 5px;
    border-radius: 5px;
    font-size: 0.85em;
    font-family: ui-monospace, Menlo, Consolas, monospace;
}
.message .content pre.sv-code {
    background: #0d1117;
    border: 1px solid var(--border-soft, rgba(255, 255, 255, 0.08));
    border-radius: 10px;
    padding: 10px 12px;
    overflow-x: auto;
    margin: 8px 0;
    color: #e6edf3;
}
.message .content pre.sv-code code { background: none; padding: 0; color: inherit; }

/* nút sao chép câu trả lời AI */
.msg-copy {
    position: absolute;
    top: -8px;
    right: -6px;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--border-soft, rgba(255, 255, 255, 0.12));
    background: var(--card-bg, #0d1117);
    color: var(--text-gray, rgba(255, 255, 255, 0.6));
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.15s, color 0.15s, background 0.15s;
    font-size: 0.72rem;
    padding: 0;
}
.message.bot:hover .msg-copy, .msg-copy:hover, .msg-copy:focus-visible { opacity: 1; }
.msg-copy:hover { color: #fff; background: var(--primary-blue, #007AFF); border-color: transparent; }
.msg-copy.copied { color: #34C759; opacity: 1; }
.chat-input-area {
    padding: 20px 24px;
    border-top: 1px solid var(--border-soft, rgba(255,255,255,0.08));
    display: flex;
    gap: 12px;
    background: var(--card-bg, #0d1117);
}
.chat-input-area textarea {
    flex: 1;
    background: var(--card-hover-bg, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--border-soft, rgba(255,255,255,0.08));
    border-radius: 24px;
    padding: 12px 18px;
    color: var(--text-white, #ffffff);
    font-family: inherit;
    font-size: 0.9rem;
    resize: none;
    outline: none;
    transition: 0.2s;
}
.chat-input-area textarea::placeholder {
    color: var(--text-muted, rgba(255, 255, 255, 0.45));
}
.chat-input-area textarea:focus {
    border-color: var(--primary-blue, #007AFF);
    box-shadow: 0 0 0 3px var(--primary-blue-glow, rgba(0, 122, 255, 0.25));
}
.btn-send {
    background: var(--primary-blue, #007AFF);
    border: none;
    padding: 0 24px;
    border-radius: 40px;
    font-weight: 600;
    color: white;
    cursor: pointer;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
}
.btn-send:hover {
    transform: scale(1.02);
    box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.4);
}
.chat-messages::-webkit-scrollbar {
    width: 6px;
}
.chat-messages::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
}
.chat-messages::-webkit-scrollbar-thumb {
    background: var(--primary-blue, #007AFF);
    border-radius: 10px;
}
.quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 24px 12px;
    background: var(--card-bg, #0d1117);
}
.quick-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(var(--primary-rgb), 0.12);
    border: 1px solid rgba(var(--primary-rgb), 0.35);
    color: var(--primary-blue, #007AFF);
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: 0.2s;
    font-family: inherit;
}
.quick-action-btn:hover {
    background: var(--primary-blue, #007AFF);
    color: white;
    border-color: var(--primary-blue, #007AFF);
    transform: translateY(-1px);
}
/* thẻ xem trước thay đổi do AI đề xuất cho Todo / Thời khóa biểu */
.ai-action-card {
    margin-top: 12px;
    padding: 12px 14px;
    border: 1px solid rgba(var(--primary-rgb), 0.35);
    border-radius: 14px;
    background: rgba(var(--primary-rgb), 0.08);
    font-size: 0.85rem;
}
.ai-action-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--primary-blue, #007AFF);
    margin-bottom: 8px;
}
.ai-action-group {
    margin: 8px 0 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted, #9aa0a6);
}
.ai-action-list { margin: 0; padding-left: 20px; }
.ai-action-list li { margin: 3px 0; line-height: 1.45; }
.ai-action-warn {
    margin-top: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(255, 149, 0, 0.12);
    border: 1px solid rgba(255, 149, 0, 0.35);
    color: #ffb340;
}
.ai-action-warn .ai-action-list { margin-top: 4px; }
.ai-action-controls { display: flex; gap: 8px; margin-top: 12px; }
.ai-action-apply, .ai-action-dismiss {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: 0.2s;
}
.ai-action-apply {
    background: var(--primary-blue, #007AFF);
    color: #fff;
    border: 1px solid var(--primary-blue, #007AFF);
}
.ai-action-apply:hover { filter: brightness(1.1); transform: translateY(-1px); }
.ai-action-dismiss {
    background: transparent;
    color: var(--text-muted, #9aa0a6);
    border: 1px solid var(--border-soft, rgba(255, 255, 255, 0.16));
}
.ai-action-dismiss:hover { color: #fff; border-color: var(--text-muted, #9aa0a6); }
.ai-action-status { margin-top: 10px; font-weight: 600; font-size: 0.82rem; }
.ai-action-status.is-ok { color: #34C759; }
.ai-action-status.is-warn { color: #ffb340; }

/* LIGHT & PINK THEMES: Đảm bảo tương phản cao cho khung chat và ô nhập */
[data-theme="pink"] .chat-card,
[data-theme="light"] .chat-card,
[data-theme="cyan"] .chat-card {
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
}

[data-theme="pink"] .chat-input-area textarea,
[data-theme="light"] .chat-input-area textarea,
[data-theme="cyan"] .chat-input-area textarea {
    background: var(--card-hover-bg);
    border: 1px solid var(--border-highlight);
    color: var(--text-white);
}

[data-theme="pink"] .chat-input-area textarea::placeholder,
[data-theme="light"] .chat-input-area textarea::placeholder,
[data-theme="cyan"] .chat-input-area textarea::placeholder {
    color: var(--text-muted);
}

[data-theme="pink"] .ai-action-dismiss:hover,
[data-theme="light"] .ai-action-dismiss:hover,
[data-theme="cyan"] .ai-action-dismiss:hover {
    color: var(--text-white);
    border-color: var(--text-muted);
}

@media (max-width: 768px) {
    .main-career {
        padding-top: calc(76px + env(safe-area-inset-top, 0px));
        padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }
    .container { padding: 0 12px; }
    .chat-card {
        height: calc(100vh - 132px);
        height: calc(100dvh - 132px);
        min-height: 420px;
        border-radius: 20px;
    }
    .chat-header { flex-direction: column; align-items: flex-start; padding: 14px 16px; }
    .header-info h2 { font-size: 1.15rem; }
    .header-info p { font-size: 0.75rem; }
    .header-info i { font-size: 22px !important; }
    .chat-messages { padding: 14px 12px; gap: 14px; }
    .message { max-width: 95%; }
    .message .content { font-size: 0.88rem; padding: 10px 14px; }
    .chat-input-area { padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px)); }
    /* 16px để iOS Safari không tự zoom khi focus vào ô nhập */
    .chat-input-area textarea { font-size: 16px; padding: 10px 14px; }
    .btn-send { padding: 0 16px; font-size: 0.85rem; }
    .quick-actions { padding: 0 12px 10px; }
}
