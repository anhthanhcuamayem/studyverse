# Studyverse gọi AI qua FreeLLMAPI (ai.studyverse.cloud) làm provider chính.
# Khi gateway này không khả dụng, app tự chuyển sang Groq (provider dự phòng).
# FreeLLMAPI local mặc định lắng nghe ở cổng 3001; đổi URL nếu gateway ở máy khác.
# Nếu Flask chạy KHÁC máy với tunnel, đặt qua domain: https://ai.studyverse.cloud/v1
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=
# Điền model hoặc combo/alias đã cấu hình trong FreeLLMAPI.
FREELLM_MODEL=auto:fast

# --- Provider dự phòng: Groq ---
# Lấy key tại https://console.groq.com/keys (key bắt đầu bằng gsk_). Groq có
# endpoint OpenAI-compatible nên app vẫn dùng chung thư viện openai.
# Model khả dụng: xem https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL mặc định là https://api.groq.com/openai/v1

# --- Thời gian/độ nhạy của cơ chế dự phòng ---
# Timeout mỗi lời gọi AI (giây). Mặc định 30.
# AI_REQUEST_TIMEOUT=30
# Giới hạn token tối đa mỗi lời gọi AI (max_tokens). Mặc định 4096.
# AI_MAX_TOKENS=4096
# Số lần SDK tự thử lại TRƯỚC khi chuyển provider. SDK mặc định là 2 (một gateway
# treo bị gọi 3 lần → phải chờ ~3x timeout mới failover). Để 0 cho failover nhanh.
AI_MAX_RETRIES=0
# Sau khi gateway chính lỗi khả dụng (timeout, mất kết nối, 5xx), tạm bỏ qua nó
# trong bấy nhiêu giây để các request sau đi thẳng Groq. Đặt 0 để tắt.
AI_FAILOVER_COOLDOWN=60

# Supabase — Flask đọc các biến này; không commit file .env thật.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SECRET_KEY=sb_secret_...  # chỉ dùng ở backend, tuyệt đối không trả ra frontend
