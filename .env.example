# Studyverse gọi AI qua một gateway OmniRoute duy nhất.
# OmniRoute local mặc định lắng nghe ở cổng 20128; đổi URL nếu gateway ở máy khác.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Điền model hoặc combo/alias đã cấu hình trong OmniRoute.
OMNIROUTE_MODEL=

# Supabase — Flask đọc các biến này; không commit file .env thật.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SECRET_KEY=sb_secret_...  # chỉ dùng ở backend, tuyệt đối không trả ra frontend
