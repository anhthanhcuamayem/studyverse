# Studyverse - environment variables mẫu. Copy thành .env và điền key thật.
# Lưu ý: .env đã bị gitignore, đừng commit key thật lên git.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Các provider khác (tuỳ chọn, app tự nhận diện provider nào có key) ---
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.6-flash  # đổi khi Google retirement model cũ (alias: gemini-flash-latest)
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# FREELLM_API_KEY=...

# Ép dùng provider mặc định (tuỳ chọn): deepseek | openai | gemini | groq | ...
# AI_PROVIDER=deepseek
# Thứ tự failover (tuỳ chọn)
# AI_PROVIDER_ORDER=deepseek,gemini,openai

# Supabase — Flask đọc các biến này; không commit file .env thật.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SECRET_KEY=sb_secret_...  # chỉ dùng ở backend, tuyệt đối không trả ra frontend
